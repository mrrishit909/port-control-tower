 "components": {
  "schemas": {
   "AisIn": {
    "properties": {
     "imo": {
      "type": "string",
      "pattern": "^\\d{7}$",
      "title": "Imo"
     },
     "positions": {
      "items": {
       "$ref": "#/components/schemas/Position"
      },
      "type": "array",
      "maxItems": 500,
      "minItems": 1,
      "title": "Positions"
     }
    },
    "type": "object",
    "required": [
     "imo",
     "positions"
    ],
    "title": "AisIn"
   },
   "BerthPlanIn": {
    "properties": {
     "locks": {
      "items": {
       "$ref": "#/components/schemas/Lock"
      },
      "type": "array",
      "maxItems": 5,
      "title": "Locks",
      "default": []
     }
    },
    "type": "object",
    "title": "BerthPlanIn"
   },
   "DisruptionIn": {
    "properties": {
     "imo": {
      "type": "string",
      "pattern": "^\\d{7}$",
      "title": "Imo"
     },
     "delay_h": {
      "type": "number",
      "maximum": 24.0,
      "minimum": 0.5,
      "title": "Delay H"
     }
    },
    "type": "object",
    "required": [
     "imo",
     "delay_h"
    ],
    "title": "DisruptionIn"
   },
   "GateIn": {
    "properties": {
     "share_of_capacity": {
      "type": "number",
      "maximum": 1.0,
      "minimum": 0.5,
      "title": "Share Of Capacity",
      "default": 0.9
     }
    },
    "type": "object",
    "title": "GateIn"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "LoadIn": {
    "properties": {
     "seed": {
      "type": "integer",
      "maximum": 1000000.0,
      "minimum": 0.0,
      "title": "Seed",
      "default": 17
     }
    },
    "type": "object",
    "title": "LoadIn"
   },
   "Lock": {
    "properties": {
     "imo": {
      "type": "string",
      "pattern": "^\\d{7}$",
      "title": "Imo"
     },
     "berth": {
      "type": "string",
      "pattern": "^B[123]$",
      "title": "Berth"
     }
    },
    "type": "object",
    "required": [
     "imo",
     "berth"
    ],
    "title": "Lock"
   },
   "Position": {
    "properties": {
     "t": {
      "type": "string",
      "format": "date-time",
      "title": "T"
     },
     "distance_nm": {
      "type": "number",
      "maximum": 500.0,
      "minimum": 0.0,
      "title": "Distance Nm"
     },
     "speed_kn": {
      "type": "number",
      "maximum": 30.0,
      "minimum": 0.0,
      "title": "Speed Kn"
     }
    },
    "type": "object",
    "required": [
     "t",
     "distance_nm",
     "speed_kn"
    ],
    "title": "Position"
   },
   "ValidationError": {
    "properties": {
     "loc": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      },
      "type": "array",
      "title": "Location"
     },
     "msg": {
      "type": "string",
      "title": "Message"
     },
     "type": {
      "type": "string",
      "title": "Error Type"
     },
     "input": {
      "title": "Input"
     },
     "ctx": {
      "type": "object",
      "title": "Context"
     }
    },
    "type": "object",
    "required": [
     "loc",
     "msg",
     "type"
    ],
    "title": "ValidationError"
   },
   "YardIn": {
    "properties": {
     "holds": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "maxItems": 200,
      "title": "Holds",
      "description": "ISO numbers of containers placed on customs hold",
      "default": []
     }
    },
    "type": "object",
    "title": "YardIn"
   }
  }
 }
}